{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "body": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "link_label": {
      "type": "string"
    },
    "link_url": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "date",
    "image"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}