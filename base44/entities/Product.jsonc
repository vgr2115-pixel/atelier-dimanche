{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "sale_price": {
      "type": "number",
      "description": "Prix remis\u00e9. Vide ou 0 = pas de remise."
    },
    "category": {
      "type": "string",
      "enum": [
        "Sacs",
        "Bananes",
        "Pochette",
        "Mini pochette",
        "Petite maroquinerie",
        "Porte-cl\u00e9s",
        "Le bois",
        "Divers",
        "Illustrations",
        "Accessoires"
      ]
    },
    "leather": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "short": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock": {
      "type": "number",
      "default": 1
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price",
    "image"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}