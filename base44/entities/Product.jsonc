{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "Sacs",
        "Ceintures",
        "Petite maroquinerie",
        "Accessoires"
      ]
    },
    "leather": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "short": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock": {
      "type": "number",
      "default": 1
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price",
    "image"
  ]
}