{
  "name": "WorkshopSession",
  "type": "object",
  "properties": {
    "workshop_slug": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "spots_total": {
      "type": "number"
    },
    "spots_taken": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string"
    }
  },
  "required": [
    "workshop_slug",
    "date",
    "time"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}