{
  "name": "Review",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "date_label": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "text",
    "source_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}