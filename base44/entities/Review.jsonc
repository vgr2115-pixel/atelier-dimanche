{
  "name": "Review",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "date_label": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "produit",
        "atelier"
      ],
      "default": "atelier",
      "description": "produit = avis apr\u00e8s un achat, atelier = avis apr\u00e8s un atelier cr\u00e9ation"
    },
    "context": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}