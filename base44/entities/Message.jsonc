{
  "name": "Message",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "enum": [
        "Une commande",
        "Un atelier",
        "Une pi\u00e8ce sur-mesure",
        "Autre"
      ]
    },
    "body": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "email",
    "body"
  ]
}